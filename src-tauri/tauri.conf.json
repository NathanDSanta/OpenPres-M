{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenPres Manager",
  "version": "0.6.0",
  "identifier": "com.nathandsanta.openpres.manager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenPres Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "maximized": true,
        "resizable": true,
        "fullscreen": false,
        "focus": false,
        "dragDropEnabled": false,
        "label": "main",
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxN0RENkE4NzM1RTUzMTkKUldRWlUxNXpxTlo5d1lrdE5CTC9uTnlOVVJkS00yZ0dNTXlnaHhjOGkxdlhzT1BydW5paDNqQ0MK",
      "endpoints": ["https://github.com/NathanDSanta/OpenPres-M/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "NathanDSanta",
    "shortDescription": "Manage OpenPres servers",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
